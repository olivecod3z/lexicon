OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=replace_with_your_available_model

# Hosted preview: shared caps across ALL free accounts, including failed attempts.
# Zero pauses new AI calls; cached resources still open. These are not currency limits.
LEXYCON_FREE_DAILY_AI_ATTEMPTS=30
LEXYCON_FREE_MONTHLY_AI_ATTEMPTS=300

# Local policy testing only. Hosted accounts always remain Free until billing exists.
LEXYCON_LOCAL_PLAN=Free
